# Database Configuration (MySQL)
# โฮสต์ของฐานข้อมูล (ใช้ localhost สำหรับการพัฒนาในเครื่อง)
DB_HOST=localhost

# พอร์ตของฐานข้อมูล MySQL (ค่าเริ่มต้นคือ 3306)
DB_PORT=3306

# ชื่อผู้ใช้ฐานข้อมูล
DB_USER=root

# รหัสผ่านฐานข้อมูล (เว้นว่างไว้ถ้าไม่มีรหัสผ่าน)
DB_PASSWORD=

# ชื่อฐานข้อมูล
DB_NAME=lomsak_tourism

# JWT Authentication
# คีย์ลับสำหรับการสร้าง JWT token (ต้องเปลี่ยนเป็นค่าที่ปลอดภัยในโปรดักชัน)
# สามารถสร้างได้จาก: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secret-key-change-this-in-production

# Google Gemini API (สำหรับ Trip Planner)
# API Key ของ Google Gemini (ไม่บังคับถ้าไม่ใช้ฟีเจอร์ Trip Planner)
GEMINI_API_KEY=your-gemini-api-key
